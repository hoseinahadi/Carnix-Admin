NEXT_PUBLIC_API_URL=https://api.carnix.ir/api
NEXT_PUBLIC_API_BASE_URL=https://api.carnix.ir
NEXT_PUBLIC_BACKEND_URL=https://api.carnix.ir
NEXT_PUBLIC_STORE_URL=https://carnix.ir
# Server-side Isaco collector configuration; keep any API token in the server's secret store.
CARNIX_API_BASE_URL=https://api.carnix.ir
# Optional when the product API requires an API token.
# CARNIX_API_TOKEN=
# Set these when Admin and the collector/data folders are not siblings on the same host.
# ISACO_COLLECTOR_DIR=/opt/carnix/isaco/scripts
# ISACO_DATA_DIR=/var/lib/carnix/isaco
# ISACO_PROFILE_DIR=/var/lib/carnix/isaco/browser-profile
# ISACO_PYTHON_COMMAND=python3
# Windows defaults to the installed Microsoft Edge. Set to chrome, msedge,
# or bundled to explicitly choose a Playwright browser channel.
# ISACO_BROWSER_CHANNEL=msedge
